# API Keys for LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Vector Database (Qdrant) Configuration
# Persists automatically to local disk storage folder
QDRANT_STORAGE_PATH=qdrant_storage
QDRANT_COLLECTION=llm_prompt_cache
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# Deep Learning Evaluator Model Configuration
EVALUATOR_WEIGHTS_DIR=evaluator_weights
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Routing, Fallback and Validator Configuration
DEFAULT_ROUTING_STRATEGY=balanced
FALLBACK_MODEL=gemini-2.5-flash
VALIDATOR_MODEL=gemini-2.5-flash
MAX_EVALUATOR_RETRIES=2
